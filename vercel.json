{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/services",
      "destination": "/#universe",
      "permanent": false
    },
    {
      "source": "/work",
      "destination": "/#work",
      "permanent": false
    },
    {
      "source": "/work/:slug",
      "destination": "/#work",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/#about",
      "permanent": false
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": false
    },
    {
      "source": "/en/services",
      "destination": "/en#universe",
      "permanent": false
    },
    {
      "source": "/en/work",
      "destination": "/en#work",
      "permanent": false
    },
    {
      "source": "/en/work/:slug",
      "destination": "/en#work",
      "permanent": false
    },
    {
      "source": "/en/about",
      "destination": "/en#about",
      "permanent": false
    },
    {
      "source": "/en/contact",
      "destination": "/en#contact",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/work/(.*)\\.(avif|jpg|jpeg|png|webp|mp4|webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
